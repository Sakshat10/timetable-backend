# Database
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Security
# REQUIRED outside development/test. A random value of at least 32 characters, for example:  openssl rand -base64 48
# Production (and any NODE_ENV that is not development or test) REFUSES TO START with this missing, too short, or a placeholder.
# In development it may stay empty (a development-only default is used, with a warning). Never reuse a development value in production.
COOKIE_SECRET=

# CORS
FRONTEND_URL=http://localhost:3000

# Trusted proxies (rate limits and request.ip). DEFAULT: false = trust nobody; X-Forwarded-For is ignored and the socket address is the client.
# Behind a reverse proxy / load balancer you MUST set this, otherwise every user shares the proxy's address and the login,
# registration and school-creation limits apply to all of them together. Values:
#   false                    trust nobody (default; use when the app is exposed directly)
#   1 .. 10                  the number of proxy hops in front of the app (use for managed platforms whose proxy addresses change)
#   10.0.0.1,172.16.0.0/12   trust forwarding headers only from these proxy addresses / CIDR ranges (also: loopback, linklocal, uniquelocal)
# "true", "*" and any /0 range are refused: they would let any client choose its own address.
# The rate limiter keeps its counters IN MEMORY of each process: run ONE application instance, or enforce the limits at the proxy as well.
TRUST_PROXY=false

# Lifetime of a school's setup token (the one-time credential for the school's first admin, returned when the school is created).
# Whole hours, 1-168. Default 24. An invalid value stops the server at startup.
# If a token expires unused, an operator issues a new one:  npm run setup-token -- --school-id <uuid> --confirm-code <school code>
SETUP_TOKEN_TTL_HOURS=24
