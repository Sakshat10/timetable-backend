# Dependencies (package-lock.json is deliberately NOT ignored: it must be committed so installs are reproducible)
node_modules/

# Environment variables
.env
.env.local
.env.*.local

# Build output
dist/
build/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Prisma
# Keep migrations folder but ignore generated client
# The generated client is in node_modules/@prisma/client

# Test coverage
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Local secrets and snapshots (never commit)
.env.*
!.env.example
*.pem
*.key
*.sql.gz
*.dump
db_before.json

# Generated artifacts
# prisma.config.ts is the source; the compiled copies next to it are build output
prisma.config.js
prisma.config.js.map
prisma.config.d.ts
prisma.config.d.ts.map
# Skills installed by `prisma skills sync` (package.json postinstall), not project source
.agents/
.cursor/
.devin/
.claude/skills/
.claude/settings.local.json

# Python (the solver)
solver/.venv/
__pycache__/
*.pyc
